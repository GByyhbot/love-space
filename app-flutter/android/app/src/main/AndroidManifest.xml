<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- INTERNET 权限必须在 main 清单声明：debug/profile 清单自带的仅覆盖开发构建，
         release 合并清单若无此条，真机上所有 socket 直接被系统拒绝（2026-11-11 真机事故）。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- 2.8.0 第 0 步：后台定位（「始终允许」单独引导授予，提示词 FGS 合规项） -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- 2.4.3 提交三（第 4 项第 10 点）：在线更新的安装包调起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 2.4.5 甲组（原生通知 · 自托管常驻连接）：
         · POST_NOTIFICATIONS：Android 13+ 运行时通知权限（插件 manifest 已带，这里显式重申）；
         · FOREGROUND_SERVICE + SPECIAL_USE：前台服务保活 SSE 长连接。type 取舍
           （第 0 步 4）：dataSync 在 Android 15+ 有 24h 内 6h 上限（常驻必被杀停）
           出局；remoteMessaging 要求默认短信应用资格出局；specialUse 无时限且
           side-load 无商店审核负担 → 选 specialUse，subtype 说明见 service property。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- 2.8.0 fix6（B1 声明补齐）：合并清单里存在 location 型前台服务
         （com.baseflow.geolocator.GeolocatorLocationService，
         foregroundServiceType=0x8，插件自带声明）——targetSdk 36 下按
         Android 14+ 口径，启动该类型 FGS 必须持有此权限，缺失会在 14+
         机型上抛 SecurityException。构建期由
         scripts/check_activity_registration.py 守卫（缺则构建失败）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- 2.8.0 fix6（B3 电池豁免）：设置卡「忽略电池优化」入口发送
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 的前提权限
         （普通权限，无运行时弹窗；豁免与否仍由 PowerManager 判定）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- 2.4.12 条目五：通知栏播放器（裁定6：两服务并存、不合并）。
         mediaPlayback 类型前台服务由 audio_service 插件声明，播放时才有；
         SSE 保活的 specialUse 服务原样不动。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- 2.4.14 audio_service 官方要求：媒体播放唤醒锁 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 2.8.7 全量：应用使用统计（PACKAGE_USAGE_STATS 走 AppOps 特殊授权，
         用户在系统「使用情况访问」页手动给；不弹窗催、不给就采集不启动） -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <!-- libAMapSDK_MAP_v9_8_3.so 在 GLMapEngine_nativeDestroy 销毁引擎释放内存时会截断
         ARM64 TBI 指针高位 tag，在 Android 14–17 触发 bionic free() SIGABRT；
         与 AmapTrackPlatformView.dispose() 生命周期重排双管齐下根治退出闪退。 -->
    <application
        android:label="love_space"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowNativeHeapPointerTagging="false">
        <activity
            android:name="cn.iepose.lovespace.love_space.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 高德地图 Android 3D SDK Key（通过 AMAP_API_KEY 环境变量或 local.properties 注入） -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />
        <!-- 2.4.5 甲组：flutter_foreground_task 11 的前台服务（service name 是插件
             硬约定不许改）。type=specialUse（依据见上方权限注释）；subtype 用英文
             避免 aapt 对非 ASCII property 的兼容风险。插件 manifest 自带 BOOT
             receiver（RebootReceiver，autoRunOnBoot: true 生效）与 WAKE_LOCK/
             RECEIVE_BOOT_COMPLETED/POST_NOTIFICATIONS 权限，合并清单自动获得。 -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep a persistent SSE connection to the self-hosted partner server so message notifications can be delivered while the app is in the background."/>
        </service>
        <!-- 2.4.3 提交三：open_filex 的 FileProvider（安装包经 content:// 共享给
             系统安装器；未配此 provider 则 openFilex 直接失败）。路径表 res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileProvider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    <!-- 2.4.14 audio_service 官方要求（通知栏播放器）：mediaPlayback 前台
         服务 + MediaButtonReceiver（锁屏/耳机媒体键）。与上方 specialUse
         SSE 保活服务并存不合并（裁定⑥）。 -->
    <service
        android:name="com.ryanheise.audioservice.AudioService"
        android:foregroundServiceType="mediaPlayback"
        android:exported="true"
        tools:ignore="Instantiatable">
      <intent-filter>
        <action android:name="android.media.browse.MediaBrowserService"/>
      </intent-filter>
    </service>
    <receiver
        android:name="com.ryanheise.audioservice.MediaButtonReceiver"
        android:exported="true"
        tools:ignore="Instantiatable">
      <intent-filter>
        <action android:name="android.intent.action.MEDIA_BUTTON"/>
      </intent-filter>
    </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 2.8.7：敏感软件多选要枚举「有启动器入口」的应用名（包可见性声明，
             不用 QUERY_ALL_PACKAGES 那种敏感全量权限） -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
</manifest>
