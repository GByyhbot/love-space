        "length": 4,
        "predictionSampleCount": 3,
        "cycleSpread": 0,
        "overdueDays": 3
      }
    },
    {
      "name": "cycleFallback_body载cycle",
      "why": "无有效 gap 但 body 带 cycle=31 → 周期回落到 31（前端口径），参与校准数仍 0",
      "records": [
        {
          "start": "2026-11-10",
          "length": 4,
          "cycle": 31
        }
      ],
      "today": "2026-11-12",
      "expect": {
        "cycle": 31,
        "length": 4,
        "predictionSampleCount": 0,
        "cycleSpread": null,
        "overdueDays": 0
