        {
          "start": "2026-05-31",
          "length": 5
        },
        {
          "start": "2026-07-03",
          "length": 5
        }
      ],
      "today": "2026-07-05",
      "expect": {
        "cycle": 32,
        "length": 5,
        "predictionSampleCount": 6,
        "cycleSpread": 4,
        "overdueDays": 0
      }
    },
    {
      "name": "outlier_52天被剔",
      "why": "间隙 28,29,28,52,29：52 偏离中位数 29 达 23 天 >7 → 剔除；剔后 4 个样本，加权 (29*6+28*5+29*4+28*3)/18=28.55→29",
      "records": [
        {
          "start": "2026-01-01",
          "length": 5
        },
        {
          "start": "2026-01-29",
          "length": 5
        },
        {
          "start": "2026-02-27",
          "length": 5
        },
        {
          "start": "2026-03-27",
          "length": 5
        },
        {
          "start": "2026-05-18",
          "length": 5
        },
        {
          "start": "2026-06-16",
          "length": 5
        }
      ],
      "today": "2026-06-18",
      "expect": {
        "cycle": 29,
        "length": 5,
        "predictionSampleCount": 4,
        "cycleSpread": 1,
        "overdueDays": 0
      }
    },
    {
      "name": "zeroSamples_回落默认",
      "why": "只有一段、无有效 gap、body 无 cycle → 周期回落 28、经期长度回落 5、参与校准数 0、偏离为 null",
      "records": [
        {
          "start": "2026-11-01",
          "length": 5
        }
      ],
      "today": "2026-11-03",
      "expect": {
        "cycle": 28,
        "length": 5,
        "predictionSampleCount": 0,
        "cycleSpread": null,
        "overdueDays": 0
      }
    },
    {
      "name": "overdue_推迟3天",
      "why": "四段间隔 28；末段 start=今天-31、length=1，超待确认窗（>confirm+7）自动定稿 → nextStart=今天-3 → 推迟 3 天。注意经期长度：近→远 [1,5,5,5] 加权 (1*6+5*5+5*4+5*3)/18=3.67→4（末段只记 1 天会把加权长度拉低，这是设计行为）",
      "records": [
        {
          "start": "2026-08-03",
          "length": 5
        },
        {
          "start": "2026-08-31",
          "length": 5
        },
        {
          "start": "2026-09-28",
          "length": 5
