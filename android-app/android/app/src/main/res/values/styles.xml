<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- targetSdk 35 强制 edge-to-edge 导致内容顶进状态栏；opt-out 后 WebView 从状态栏下方布局。
             状态栏底色/图标深浅由 JS 侧 StatusBar 插件按明暗主题动态覆盖，此处为默认浅色兜底 -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">#FCF8F9</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <!-- ⚠️ 这里曾经加过 windowOptOutEdgeToEdgeEnforcement 做实验，结论是**没用**：
         属性确实生效了（窗口的 pfl 里 EDGE_TO_EDGE_ENFORCED 消失，系统桌面/IME 都还有），
         但窗口依然不随键盘缩（frame 恒 [0,0][1080,2400]，mAppBounds 底部不减键盘高度），
         因为本 App 的 decorView 一直带着 LAYOUT_FULLSCREEN —— 来源是 @capacitor/status-bar
         的 StatusBarConfig.overlaysWebView 默认 true。它比 edge-to-edge 更早接管了布局。
         要真正恢复 adjustResize 得先关掉 overlaysWebView，代价是失去沉浸式状态栏。
         详见 .workbuddy/memory/2026-11-08.md。 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
