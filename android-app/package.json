{
  "name": "lovespace-apk",
  "version": "1.1.8",
  "private": true,
  "description": "恋爱空间 Android APK 原生壳（Capacitor 7 远程加载模式）",
  "scripts": {
    "cap": "cap",
    "assets": "capacitor-assets generate --android",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "build:debug": "cd android && gradlew.bat assembleDebug",
    "postinstall": "python patches/apply_background_mode_patch.py"
  },
  "dependencies": {
    "@anuradev/capacitor-background-mode": "^7.0.2",
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/status-bar": "^7.0.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^7.0.0"
  }
}
